{
  "include": ["src", "scripts", "vite", "*.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2024",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "#app/*": ["./src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  }
}
