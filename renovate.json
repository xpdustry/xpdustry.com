{
  "extends": ["local>xpdustry/.github:renovate-shared"],
  "packageRules": [
    {
      "matchPackageNames": ["@tanstack/react-router", "@tanstack/react-start"],
      "groupName": "tanstack start",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react"
    },
    {
      "matchPackageNames": ["@takumi-rs/**"],
      "groupName": "takumi"
    },
    {
      "matchPackageNames": ["oxfmt", "oxlint"],
      "groupName": "oxc tools"
    },
    {
      "matchPackageNames": ["node", "docker.io/library/node", "@types/node"],
      "groupName": "nodejs"
    }
  ]
}
