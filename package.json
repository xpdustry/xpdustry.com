{
  "name": "xpdustry-website",
  "version": "0.2.0",
  "private": true,
  "description": "The xpdustry website",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node dist/server/node.js",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix --fix-suggestions",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@solidjs/meta": "1.0.0-next.1",
    "@solidjs/router": "2.0.0-next.15",
    "@solidjs/web": "2.0.0-rc.0",
    "filesystem-routing": "0.2.1",
    "lucide": "^1.31.0",
    "simple-icons": "^16.28.0",
    "solid-js": "2.0.0-beta.34",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "0.0.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "3.0.0-next.26",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0"
}
