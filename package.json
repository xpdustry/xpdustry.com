{
  "name": "xpdustry-website",
  "version": "0.3.0",
  "private": true,
  "description": "The xpdustry website",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/serve.ts",
    "pattern": "node scripts/reticulate-gen.ts && pnpm textures",
    "textures": "node scripts/textures.ts",
    "translations": "gt generate",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix --fix-suggestions",
    "test": "pnpm test:unit && pnpm test:artifact",
    "test:unit": "vitest run --project unit",
    "test:artifact": "pnpm build && vitest run --project artifact",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@takumi-rs/core": "2.17.1",
    "@takumi-rs/helpers": "2.17.1",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "gt-react": "^11.4.20",
    "gt-tanstack-start": "^11.4.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "srvx": "^1.0.6",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/momo-trust-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/momo-trust-display": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-png": "^8.0.0",
    "gt": "^2.27.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.78.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.0",
    "yaml": "2.9.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
